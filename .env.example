# انسخ هذا الملف إلى .env واملأ القيم من لوحة Supabase
# Settings → API   (لا ترفع ملف .env إلى Git أبداً)

SUPABASE_PROJECT_ID=your-project-ref
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-anon-publishable-key

VITE_SUPABASE_PROJECT_ID=your-project-ref
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-publishable-key

# سري — لا يوضع في .env ولا يُرفع لـ Git.
# يُضاف فقط كـ Secret في Cloudflare:  wrangler secret put SUPABASE_SERVICE_ROLE_KEY
# SUPABASE_SERVICE_ROLE_KEY=
